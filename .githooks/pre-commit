#!/bin/sh
# Block commits that add secrets. Enable with: scripts/setup-hooks.sh
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so the secret scan cannot run." >&2
  echo "Install it from https://github.com/gitleaks/gitleaks/releases (v8+), then retry." >&2
  exit 1
fi
exec gitleaks git --staged --redact --no-banner -v --config "$(git rev-parse --show-toplevel)/.gitleaks.toml"
